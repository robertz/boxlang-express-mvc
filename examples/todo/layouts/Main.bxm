<bx:output><!doctype html>
<html lang="en">
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<title>#encodeForHTML( prc.title ?: "Todos" )#</title>
	<style>
		body { font: 16px/1.5 system-ui, sans-serif; max-width: 34rem; margin: 2rem auto; padding: 0 1rem; color: ##1f2933; }
		h1 a { color: inherit; text-decoration: none; }
		form { display: inline; }
		ul { list-style: none; padding: 0; }
		li { display: flex; gap: .5rem; align-items: center; padding: .4rem 0; border-bottom: 1px solid ##e4e7eb; }
		li .title { flex: 1; }
		li.done .title { text-decoration: line-through; color: ##7b8794; }
		input[type=text] { font: inherit; padding: .35rem .5rem; width: 70%; }
		button { font: inherit; cursor: pointer; }
		nav a { margin-right: .75rem; }
		nav a.current { font-weight: 600; }
		.error { color: ##b42318; }
		footer { margin-top: 1rem; color: ##52606d; display: flex; justify-content: space-between; }
	</style>
</head>
<body>
	<h1><a href="#event.buildLink( "todos.index" )#">Todos</a></h1>
	#view()#
</body>
</html>
</bx:output>
