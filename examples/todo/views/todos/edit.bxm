<bx:output>
<form method="post" action="#event.buildLink( "todos.update", { id: prc.todo.id } )#">
	<input type="hidden" name="_csrf" value="#encodeForHTML( event.getRequest().csrfToken() )#">
	<input type="text" name="title" value="#encodeForHTML( prc.todo.title )#" maxlength="200" autofocus>
	<button>Save</button>
	<a href="#event.buildLink( "todos.index" )#">Cancel</a>
</form>
<bx:if ( rc.error ?: "" ) == "title">
	<p class="error">A todo needs a title.</p>
</bx:if>
</bx:output>
