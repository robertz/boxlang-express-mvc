class {

	function configure() {
		// The default event
		route( "/", "main.index" )

		// A healthcheck route
		get( "/healthcheck", ( req, res ) => res.send( "Ok!" ) )

		// A RESTful route
		get( "/api/echo", ( req, res ) => res.json( { error: false, data: "Welcome to my awesome API!" } ) )

		// A page with no handler behind it
		route( "/about" ).as( "about" ).toView( "main/about" )

		// Conventions-based routing
		route( "/:handler/:action?" ).end()
	}

}
