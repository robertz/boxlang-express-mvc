<bx:output><!doctype html>
<html lang="en">
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<title>#encodeForHTML( prc.welcomeMessage ?: prc.appName )#</title>
	<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
	<link href="/includes/css/app.css" rel="stylesheet">
</head>
<body class="d-flex flex-column min-vh-100">
	<header>
		<nav class="navbar navbar-expand-lg navbar-dark bg-dark">
			<div class="container-fluid">
				<a class="navbar-brand" href="#event.buildLink( "main.index" )#"><strong>#encodeForHTML( prc.appName )#</strong></a>
				<ul class="navbar-nav ms-auto">
					<li class="nav-item dropdown">
						<a class="nav-link dropdown-toggle" href="##" role="button" data-bs-toggle="dropdown">About</a>
						<ul class="dropdown-menu dropdown-menu-end">
							<li><a class="dropdown-item" href="https://github.com/robertz/boxlang-express-mvc">boxlang-express-mvc</a></li>
							<li><a class="dropdown-item" href="https://github.com/robertz/boxlang-express">BoxExpress</a></li>
							<li><a class="dropdown-item" href="https://boxlang.io">BoxLang</a></li>
						</ul>
					</li>
				</ul>
			</div>
		</nav>
	</header>

	<main class="flex-shrink-0">#view()#</main>

	<footer class="mt-auto border-top py-3 bg-light">
		<div class="container d-flex justify-content-between">
			<span class="text-muted">#encodeForHTML( prc.appName )#</span>
			<a href="##">Back to top</a>
		</div>
	</footer>

	<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
</bx:output>
