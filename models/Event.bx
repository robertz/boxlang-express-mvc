/**
 * One per request. Wraps req and res with the ColdBox request-context
 * method names.
 */
class {

	static {
		CONTENT_TYPES = {
			json: "application/json; charset=utf-8",
			html: "text/html; charset=utf-8",
			text: "text/plain; charset=utf-8",
			xml: "application/xml; charset=utf-8"
		}
	}

	function init( mvc, req, res, rc, handlerName, actionName ) {
		variables.mvc = mvc
		variables.req = req
		variables.res = res
		variables.rc = rc
		variables.handlerName = handlerName
		variables.actionName = actionName
		variables.view = ""
		variables.layout = ""
		variables.useLayout = true
		variables.skipRender = false
		variables.flash = new Flash( req )
		return this
	}

	function getFlash() {
		return variables.flash
	}

	/**
	 * Sets a value in rc only if it isn't there already.
	 */
	function paramValue( name, value ) {
		if ( !variables.rc.keyExists( name ) ) {
			variables.rc[ name ] = value
		}
		return this
	}

	/**
	 * The named keys of rc, and nothing else a client may have sent.
	 */
	function getOnly( keys ) {
		var wanted = isArray( keys ) ? keys : listToArray( keys )
		var picked = {}
		for ( var key in wanted ) {
			key = trim( key )
			if ( variables.rc.keyExists( key ) ) {
				picked[ key ] = variables.rc[ key ]
			}
		}
		return picked
	}

	function getExcept( keys ) {
		var unwanted = isArray( keys ) ? keys : listToArray( keys )
		var rest = {}
		for ( var key in variables.rc ) {
			if ( !unwanted.findNoCase( key ) ) {
				rest[ key ] = variables.rc[ key ]
			}
		}
		return rest
	}

	function isAjax() {
		return variables.req.xhr ? true : false
	}

	/**
	 * The request body. With json = true it is the parsed value (what
	 * boxExpressJSON() produced, or a text body deserialized here);
	 * otherwise it is text.
	 */
	function getHTTPContent( json = false ) {
		var body = variables.req.body
		if ( json ) {
			return isSimpleValue( body ) ? ( len( trim( body ) ) ? jsonDeserialize( body ) : {} ) : body
		}
		if ( isSimpleValue( body ) ) {
			return body
		}
		return isBinary( body ) ? toString( body, "UTF-8" ) : jsonSerialize( body )
	}

	/**
	 * Copies rc into a model: a struct key, or a setter (setTitle() for
	 * title), for each key that passes include and exclude. Give include
	 * whenever rc came from a form, or a client can set any property.
	 */
	function populateModel( model, include = "", exclude = "" ) {
		var included = isArray( include ) ? include : listToArray( include )
		var excluded = isArray( exclude ) ? exclude : listToArray( exclude )
		var plain = isStruct( model ) && !isObject( model )
		var settable = {}
		if ( !plain ) {
			var md = getMetadata( model )
			while ( true ) {
				for ( var prop in md.properties ?: [] ) {
					settable[ prop.name ] = true
				}
				if ( !isStruct( md.extends ?: "" ) || md.extends.isEmpty() ) {
					break
				}
				md = md.extends
			}
		}
		for ( var key in variables.rc ) {
			if ( ( included.len() && !included.findNoCase( key ) ) || excluded.findNoCase( key ) ) {
				continue
			}
			if ( plain ) {
				model[ key ] = variables.rc[ key ]
			} else if ( structKeyExists( model, "set" & key ) || settable.keyExists( key ) ) {
				invoke( model, "set" & key, [ variables.rc[ key ] ] )
			}
		}
		return model
	}

	function announce( name, data = {}, async = false ) {
		variables.mvc.announce( name, data, async, this, variables.rc, variables.res.locals )
		return this
	}

	function getRequest() {
		return variables.req
	}

	function getResponse() {
		return variables.res
	}

	function getCollection() {
		return variables.rc
	}

	function getPrivateCollection() {
		return variables.res.locals
	}

	function getValue( name, defaultValue = "" ) {
		return variables.rc[ name ] ?: defaultValue
	}

	function setValue( name, value ) {
		variables.rc[ name ] = value
		return this
	}

	function valueExists( name ) {
		return variables.rc.keyExists( name )
	}

	function getCurrentHandler() {
		return variables.handlerName
	}

	function getCurrentAction() {
		return variables.actionName
	}

	function getCurrentEvent() {
		return len( variables.handlerName ) ? variables.handlerName & "." & variables.actionName : ""
	}

	function getHTTPMethod() {
		return variables.req.method
	}

	function getHTTPHeader( name, defaultValue = "" ) {
		return variables.req.get( name ) ?: defaultValue
	}

	function setHTTPHeader( name, value ) {
		variables.res.set( name, value )
		return this
	}

	function setStatusCode( code ) {
		variables.res.status( code )
		return this
	}

	function setView( view, layout = "" ) {
		variables.view = view
		if ( len( layout ) ) {
			setLayout( layout )
		}
		return this
	}

	function setLayout( name ) {
		variables.layout = name
		variables.useLayout = true
		return this
	}

	function noLayout() {
		variables.useLayout = false
		return this
	}

	function noRender() {
		variables.skipRender = true
		return this
	}

	function isNoRender() {
		return variables.skipRender
	}

	function isViewSet() {
		return len( variables.view ) > 0
	}

	function getView() {
		return len( variables.view ) ? variables.view : variables.handlerName.replace( ".", "/", "all" ) & "/" & variables.actionName
	}

	function usesLayout() {
		return variables.useLayout
	}

	function getLayoutName() {
		return variables.layout
	}

	/**
	 * Sends the response now. json takes a plain struct or array (a class
	 * instance serializes as {}); the other types take a string.
	 */
	function renderData( type = "json", data = "", statusCode = 200, contentType = "" ) {
		if ( !static.CONTENT_TYPES.keyExists( type ) ) {
			throw( type = "BoxExpressMvc.InvalidRenderType", message = "renderData() type must be json, html, text or xml, not [#type#]" )
		}
		variables.res.status( statusCode ).type( len( contentType ) ? contentType : static.CONTENT_TYPES[ type ] )
		variables.res.send( type == "json" ? jsonSerialize( data ) : data )
		return this
	}

	/**
	 * to is a path on this site (starts with one "/"), a URL with a
	 * scheme, a route name, or a "handler.action". A browser reads
	 * "//host" and "/\host" as another site, so those are refused.
	 */
	function relocate( to, queryString = "", statusCode = 302 ) {
		if ( reFind( "^[/\\]\s*[/\\]", to ) ) {
			throw( type = "BoxExpressMvc.InvalidRelocation", message = "relocate() will not redirect to [#to#]: it looks like a path but a browser reads it as another site. Use a full URL with a scheme for that" )
		}
		var target = ( to.left( 1 ) == "/" || find( "://", to ) ) ? to : buildLink( to )
		if ( len( queryString ) ) {
			target &= ( find( "?", target ) ? "&" : "?" ) & queryString
		}
		variables.res.redirect( target, statusCode )
		return this
	}

	function buildLink( to, params = {} ) {
		return variables.req.baseUrl & variables.mvc.linkTo( to, params )
	}

}
