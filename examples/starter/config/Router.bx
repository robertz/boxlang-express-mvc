class {

	function configure() {
		// The default event
		route( "/", "main.index" )

		// A healthcheck route
		route( "/healthcheck", ( req, res ) => res.send( "Ok!" ) )

		// A RESTful route
		route( "/api/echo", ( req, res ) => res.json( { error: false, data: "Welcome to my awesome API!" } ) )

		// Conventions-based routing
		route( "/:handler/:action?" ).end()
	}

}
