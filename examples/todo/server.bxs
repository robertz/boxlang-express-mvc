/**
 * A todo list on boxlang-express-mvc.
 *
 *   boxlang server.bxs        (from this directory)
 */
app = boxExpress()
app.set( "env", getSystemSetting( "APP_ENV", "production" ) )
// With APP_ENV=development, an edit to a handler, model or the routes
// file restarts the server. Views never need it.
app.set( "reloadOnChange", app.getSetting( "env" ) == "development" )

// Behind a reverse proxy, also set "trust proxy" so req.ip is the
// visitor and not the proxy; otherwise everyone shares one rate limit.
app.use( boxExpressHelmet( {
	frameOptions: "DENY",
	contentSecurityPolicy: "default-src 'self'; style-src 'self' 'unsafe-inline'; form-action 'self'; frame-ancestors 'none'"
} ) )
app.use( boxExpressRateLimit( {
	max: 120,
	handler: ( req, res, next, info ) => res.status( 429 ).send( "Too many requests. Try again in a minute." )
} ) )

// Every form posts a token that has to match the one in the visitor's
// session (the views get it from event.getRequest().csrfToken()). The
// session comes first, then the form parser, then the check.
app.use( boxExpressSession( { saveUninitialized: false } ) )
app.use( boxExpressUrlencoded() )
app.use( boxExpressCsrf() )

// One instance of each service, built before listen(). Handlers are
// shared by every request, so a service has to be safe to call from
// many threads at once.
svc = { todoService: new models.TodoService() }

mvc = boxExpressMvc( {
	handlers: expandPath( "./handlers" ),
	views: expandPath( "./views" ),
	layouts: expandPath( "./layouts" ),
	routes: expandPath( "./config/Router.bx" ),
	services: svc
} )
app.use( mvc.router() )

app.use( ( req, res, next ) => res.status( 404 ).send( "Page not found" ) )

app.use( ( err, req, res, next ) => {
	println( "Error on #req.method# #req.originalUrl#: #err.message#" )
	res.status( 500 ).send( "Something went wrong." )
} )

app.listen( getSystemSetting( "PORT", 3000 ), ( port ) => println( "http://localhost:#port#" ) )
