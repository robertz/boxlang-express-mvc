/**
 * The ColdBox starter template, rebuilt on boxlang-express-mvc. After
 * `boxlang setup-tests.bxs` in the repo root:
 *
 *   cd examples && boxlang server.bxs
 *
 * This file does the jobs of Application.cfc, index.cfm and
 * config/ColdBox.cfc.
 */
app = boxExpress()
app.set( "env", getSystemSetting( "APP_ENV", "development" ) )
app.locals.appName = "Your app name here"

app.use( "/includes", boxExpressStatic( expandPath( "./includes" ) ) )
app.use( boxExpressJSON(), boxExpressUrlencoded() )

mvc = boxExpressMvc( {
	handlers: expandPath( "./handlers" ),
	views: expandPath( "./views" ),
	layouts: expandPath( "./layouts" ),
	defaultLayout: "Main",
	routes: expandPath( "./config/Router.bx" )
} )

// Read once at startup; every request gets the same read-only listing.
registeredHandlers = mvc.getHandlers()
appName = app.locals.appName
app.use( ( req, res, next ) => {
	res.locals.appName = appName
	res.locals.registeredHandlers = registeredHandlers
	next()
} )

app.use( mvc.router() )

// ColdBox's invalidEventHandler / onMissingTemplate
app.use( ( req, res, next ) => res.status( 404 ).send( "Page not found" ) )

// ColdBox's onException
app.use( ( err, req, res, next ) => {
	println( "Error on #req.method# #req.originalUrl#: #err.message#" )
	res.status( 500 ).send( "Oops, something went wrong." )
} )

app.listen( getSystemSetting( "PORT", 3000 ), ( port ) => println( "http://localhost:#port#" ) )
