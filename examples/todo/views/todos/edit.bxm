<bx:output>
<form method="post" action="#event.buildLink( "todos.update", { id: prc.todo.id } )#">
	<input type="hidden" name="_csrf" value="#encodeForHTMLAttribute( event.getRequest().csrfToken() )#">
	<input type="text" name="title" value="#encodeForHTMLAttribute( prc.todo.title )#" maxlength="200" autofocus>
	<button>Save</button>
	<a href="#event.buildLink( "todos.index" )#">Cancel</a>
</form>
</bx:output>
